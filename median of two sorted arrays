class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        vector<int> marr(nums1.size() + nums2.size());
        int i,j,n,k=0;
        i=0;
        j=0;
        while (i<nums1.size()&&j<nums2.size()) {
            if (nums1[i]<=nums2[j]) {
                marr[k]=nums1[i];
                i++;
            } else {
                marr[k]=nums2[j];
                j++;
            }
            k++;
        }
        for (;i<nums1.size();i++) {
            marr[k]=nums1[i];
            k++;
        }
        for (;j<nums2.size();j++) {
            marr[k]=nums2[j];
            k++;
        }
        n=marr.size();
        if (n%2!=0) {
            return marr[n/2];
        } else {
            return (marr[n/2-1]+marr[n/2])/2.0;
        }
    }
};
