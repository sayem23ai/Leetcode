class Solution {
public:
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        unordered_map<int,int> mp;

        mp[0] = 1; // handles subarrays starting from index 0

        int sum = 0;
        int count = 0;

        for(int i = 0; i < nums.size(); i++) {
            sum += nums[i]; // current prefix sum

            // find previous prefix sum so remaining sum = goal
            count += mp[sum - goal];

            mp[sum]++; // store current prefix sum
        }

        return count;
    }
};
