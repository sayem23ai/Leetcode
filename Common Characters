class Solution {
public:
    vector<string> commonChars(vector<string>& words) {
        vector<int> common(26, 0);

        // Count frequency of characters in the first word
        for (char ch : words[0]) {
            common[ch - 'a']++;
        }

        // Compare with the remaining words
        for (int i = 1; i < words.size(); i++) {
            vector<int> freq(26, 0);

            for (char ch : words[i]) {
                freq[ch - 'a']++;
            }

            // Keep the minimum frequency
            for (int j = 0; j < 26; j++) {
                common[j] = min(common[j], freq[j]);
            }
        }

        // Build the answer
        vector<string> ans;

        for (int i = 0; i < 26; i++) {
            while (common[i] > 0) {
                ans.push_back(string(1, char(i + 'a')));
                common[i]--;
            }
        }

        return ans;
    }
};
