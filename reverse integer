class Solution {
public:
    int reverse(int x) {
        int n=0,a=0,num;
        num=x;
        while(x!=0){
           n=x%10;
            if (a>INT_MAX/10 || (a==INT_MAX/10 && n>7))
                return 0;
            if (a<INT_MIN/10 || (a==INT_MIN/10 && n<-8))
                return 0;
           a=n+a*10;
           x=x/10;
        }
        return a;
    }
};
